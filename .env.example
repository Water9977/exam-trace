# Frontend (copy to .env.local)
# Only needed when the backend is NOT served from the same origin, e.g. when
# running `next dev` and `uvicorn` separately. Include the /api prefix.
# Leave unset on Vercel and with `vercel dev`: the app calls /api on its own origin.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Backend (put in backend/.env, not here)
# GEMINI_API_KEY=your_key_here
